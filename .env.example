# Server
PORT=10000
HOST=0.0.0.0
NODE_ENV=development

# MongoDB NoSQL Persistence (Required)
# Use MONGODB_URI in production (Render) or VOXASR_MONGODB_URI in local .env to avoid overriding other projects
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/voxasr?retryWrites=true&w=majority
MONGODB_DB=voxasr

# Security & Rate Limiting
CORS_ORIGIN=*
RATE_LIMIT_MAX=180

# Optional external Python retraining daemon URL
UPGRADE_DAEMON_URL=
