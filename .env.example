# Server
PORT=10000
HOST=0.0.0.0
NODE_ENV=development

# Database (leave empty locally to use zero-config SQLite/JSON; Render injects DATABASE_URL for PostgreSQL)
DATABASE_URL=

# Security & Rate Limiting
CORS_ORIGIN=*
RATE_LIMIT_MAX=180

# Optional external Python retraining daemon URL
UPGRADE_DAEMON_URL=
