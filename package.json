{
  "name": "webapp",
  "version": "3.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build": "node -e \"console.log('Pure JS Node server ready (no build step required)')\"",
    "train": "python training/train_chatbot.py",
    "upgrade": "python training/auto_train_pipeline.py",
    "harvest": "python training/knowledge_harvester.py",
    "daemon": "python training/upgrade_server.py",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "hono": "^4.13.14",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}
